rules_version = '2';

// Family circles are read-only for the apps: only the backend (functions/)
// adds or removes members. Apps can only ask for help, ask "is this a scam?",
// and answer those requests inside their own circle.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function circleData(cid) { return get(/databases/$(database)/documents/circles/$(cid)).data; }
    function isHelper(cid) { return signedIn() && request.auth.uid in circleData(cid).helperIds; }
    function isParent(cid) { return signedIn() && request.auth.uid in circleData(cid).parentIds; }
    function isMember(cid) { return isHelper(cid) || isParent(cid); }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function smallNumber(n) {
      return (n is int || n is float) && n >= 0 && n <= 1000000;
    }
    // Names shown in alerts and on the helper's screen.
    function shortName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function validQuality(q) {
      return q is map
        && q.keys().hasOnly(['seconds', 'relay', 'rttMs', 'fps', 'height', 'kbps', 'lossPct', 'freezes', 'codec', 'enc', 'timeline'])
        && q.keys().hasAll(['seconds', 'relay', 'rttMs', 'fps', 'height', 'kbps', 'lossPct', 'freezes', 'codec'])
        && smallNumber(q.seconds) && q.relay is bool && smallNumber(q.rttMs) && smallNumber(q.fps)
        && smallNumber(q.height) && smallNumber(q.kbps) && smallNumber(q.lossPct) && smallNumber(q.freezes)
        && q.codec is string && q.codec.size() <= 20
        // Optional: her phone's video encoder's name, and a timeline of
        // numbers every 2 seconds (web/src/quality.js). Nothing else fits.
        && (!('enc' in q) || (q.enc is string && q.enc.matches('[A-Za-z0-9._ -]{0,40}')))
        // (A plain * and a size cap: a counted repeat that large can be
        // refused by the database's pattern engine, which failed the save.)
        && (!('timeline' in q) || (q.timeline is string && q.timeline.size() <= 20000
          && q.timeline.matches('([0-9]{1,5},[0-9]{1,5},[0-9]{1,3},[0-9]{1,3},[0-9]{1,4},[cbon-],[01](,[0-9]{1,6})*;)*')));
    }

    // Alert tokens: one per installed device. A small cap stops anyone
    // stuffing their own record.
    function validUserFields() {
      let d = request.resource.data;
      return (!('fcmTokens' in d) || (d.fcmTokens is list && d.fcmTokens.size() <= 10))
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 60))
        && (!('platform' in d) || d.platform in ['android', 'ios', 'web'])
        && (!('device' in d) || validDevice(d.device));
    }

    // What kind of phone this is, so the helper's app can pick the right way
    // to help (in-app screen sharing on Android, FaceTime on iPhone).
    function validDevice(v) {
      return v is map
        && v.keys().hasAll(['platform'])
        && v.keys().hasOnly(['platform', 'model', 'osVersion'])
        && v.platform in ['android', 'ios', 'computer']
        && (!('model' in v) || (v.model is string && v.model.size() <= 60))
        && (!('osVersion' in v) || (v.osVersion is int && v.osVersion >= 0 && v.osVersion < 100));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'fcmTokens', 'platform', 'device'])
        && validUserFields();
      allow update: if signedIn() && request.auth.uid == uid
        && changedOnly(['displayName', 'fcmTokens', 'platform', 'device'])
        && validUserFields();
    }

    match /circles/{cid} {
      allow read: if isMember(cid);

      match /invites/{iid} {
        allow read: if isHelper(cid)
          || (signedIn() && resource.data.claimedBy == request.auth.uid);
      }

      match /helpRequests/{rid} {
        allow read: if isMember(cid);
        allow create: if isParent(cid)
          && request.resource.data.keys().hasOnly(['parentId', 'parentName', 'status', 'createdAt', 'practice'])
          && request.resource.data.get('practice', false) is bool
          && request.resource.data.parentId == request.auth.uid
          && shortName(request.resource.data.parentName)
          && request.resource.data.status == 'waiting'
          && request.resource.data.createdAt == request.time;
        // A finished or cancelled request stays finished: nobody can reopen it.
        // Helpers: waiting -> accepted (one helper takes it), then -> done.
        allow update: if (isHelper(cid)
            && changedOnly(['status', 'helperId', 'helperName', 'updatedAt'])
            && ((resource.data.status == 'waiting' && request.resource.data.status in ['accepted', 'done'])
              || (resource.data.status == 'accepted' && request.resource.data.status == 'done'))
            && request.resource.data.helperId == request.auth.uid
            && request.resource.data.helperName is string
            && request.resource.data.helperName.size() <= 60)
          || (isParent(cid)
            && resource.data.parentId == request.auth.uid
            && changedOnly(['status', 'updatedAt'])
            && resource.data.status in ['waiting', 'accepted']
            && request.resource.data.status in ['cancelled', 'done']);
      }

      // "Ring Mom's phone": a helper makes a parent's phone play loudly so it
      // can be found. Only helpers in the family, only for a parent in it, in
      // their own name. Kept as a record of who rang and when.
      match /rings/{ringid} {
        allow read: if isMember(cid);
        allow create: if isHelper(cid)
          && request.resource.data.keys().hasOnly(['parentId', 'helperId', 'helperName', 'createdAt'])
          && request.resource.data.parentId in circleData(cid).parentIds
          && request.resource.data.helperId == request.auth.uid
          && request.resource.data.helperName is string
          && request.resource.data.helperName.size() <= 60
          && request.resource.data.createdAt == request.time;
      }

      // Screen sharing (stage 2). Never unattended: only the parent's own
      // phone can start a share, a helper can join only within 10 minutes,
      // and either side can end it. Ended shares stay as the family's
      // history of who connected, when and for how long.
      match /screenShares/{shid} {
        function share() { return resource.data; }
        function onShare() {
          return signedIn() && (request.auth.uid == share().parentId || request.auth.uid == share().get('helperId', null));
        }
        allow read: if isMember(cid);
        allow create: if isParent(cid)
          && request.resource.data.keys().hasOnly(['parentId', 'parentName', 'status', 'createdAt'])
          && request.resource.data.parentId == request.auth.uid
          && request.resource.data.parentName is string
          && request.resource.data.parentName.size() <= 60
          && request.resource.data.status == 'waiting'
          && request.resource.data.createdAt == request.time;
        allow update: if
          // One helper joins a waiting share, while it's fresh.
          (isHelper(cid)
            && share().status == 'waiting'
            && request.time < share().createdAt + duration.value(10, 'm')
            && changedOnly(['status', 'helperId', 'helperName', 'startedAt'])
            && request.resource.data.status == 'live'
            && request.resource.data.helperId == request.auth.uid
            && request.resource.data.helperName is string
            && request.resource.data.helperName.size() <= 60
            && request.resource.data.startedAt == request.time)
          // The parent or the joined helper ends it, any time.
          || (isMember(cid) && onShare()
            && share().status in ['waiting', 'live']
            && changedOnly(['status', 'endedBy', 'endedAt'])
            && request.resource.data.status == 'ended'
            && request.resource.data.endedBy == request.auth.uid
            && request.resource.data.endedAt == request.time)
          // The joined helper's page saves how smooth it was, once: only
          // numbers and the video format's name, never anything on screen.
          || (isHelper(cid)
            && request.auth.uid == share().get('helperId', null)
            && share().status in ['live', 'ended']
            && !('quality' in share())
            && changedOnly(['quality'])
            && validQuality(request.resource.data.quality));

        // Connection setup messages (WebRTC offer/answer/candidates, and a
        // "hello" when the helper's page (re)joins), only
        // between the two people on a live share. The video itself never
        // passes through here.
        match /signals/{sigid} {
          function parentShare() {
            return get(/databases/$(database)/documents/circles/$(cid)/screenShares/$(shid)).data;
          }
          function onThisShare() {
            let s = parentShare();
            return signedIn() && isMember(cid)
              && (request.auth.uid == s.parentId || request.auth.uid == s.get('helperId', null));
          }
          allow read: if onThisShare();
          allow create: if onThisShare()
            && parentShare().status == 'live'
            && request.resource.data.keys().hasOnly(['from', 'type', 'payload', 'createdAt'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.type in ['offer', 'answer', 'candidate', 'hello']
            && request.resource.data.payload is string
            && request.resource.data.payload.size() <= 20000
            && request.resource.data.createdAt == request.time;
        }
      }

      match /scamChecks/{sid} {
        allow read: if isMember(cid);
        allow create: if isParent(cid)
          && request.resource.data.keys().hasOnly(['parentId', 'parentName', 'text', 'createdAt', 'verdict'])
          && request.resource.data.parentId == request.auth.uid
          && shortName(request.resource.data.parentName)
          && request.resource.data.verdict == null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if isHelper(cid)
          && resource.data.verdict == null
          && changedOnly(['verdict', 'note', 'answeredBy', 'answeredByName', 'answeredAt'])
          && request.resource.data.verdict in ['scam', 'unsure', 'safe']
          && request.resource.data.answeredBy == request.auth.uid
          && shortName(request.resource.data.answeredByName)
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500;
      }
    }
  }
}
