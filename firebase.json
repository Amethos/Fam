{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": [{ "source": "functions", "codebase": "default", "ignore": ["node_modules", "test", ".env.local"] }],
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "/join", "destination": "/join.html" }],
    "headers": [
      { "source": "/download/*.apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }] },
      { "source": "/firebase-messaging-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": { "firestore": { "port": 8080 }, "auth": { "port": 9099 }, "functions": { "port": 5001 }, "ui": { "enabled": false } }
}
