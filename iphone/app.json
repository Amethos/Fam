{
  "expo": {
    "name": "My Tech Kid",
    "slug": "my-tech-kid",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mytechkid",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F0E1",
    "ios": {
      "bundleIdentifier": "com.amethos.mytechkid",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.amethos.mytechkid"
        ]
      },
      "infoPlist": {
        "RTCAppGroupIdentifier": "group.com.amethos.mytechkid",
        "RTCScreenSharingExtension": "com.amethos.mytechkid.broadcast",
        "UIBackgroundModes": [
          "voip"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E1",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/varela_round.ttf"
          ]
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "My Tech Kid uses the camera only when you choose to show your family something.",
          "microphonePermission": "My Tech Kid uses the microphone only when you choose to talk to your family."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fccf3a38-99c3-4c6d-a202-314161979331"
      }
    }
  }
}
