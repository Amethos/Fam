{
  "expo": {
    "name": "My Tech Kid",
    "slug": "my-tech-kid",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mytechkid",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F0E1",
    "ios": {
      "bundleIdentifier": "com.amethos.mytechkid",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E1",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/varela_round.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fccf3a38-99c3-4c6d-a202-314161979331"
      }
    }
  }
}
